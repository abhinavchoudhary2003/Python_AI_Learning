sample_url = 'http://coreyms.com'

print(sample_url)

# Reverse the String
print(sample_url[::-1]) # :: , [start:end:step] here start is :, end is : and step is -1  
                        # start : — it means  start empty → defaults to the beginning ,stop: — left empty → defaults to the end, step — -1 → move backwards, one character at a time
s = 'python'
print(s[5:2:-1])  # print 'noh' starts from n and end at t and -1 means read from reverse                  



# Get the top level Domain
print(sample_url[-4:])

# print string without http://
print(sample_url[7:])
print(sample_url[-11:])

# print the url without http:// or the top level domain(.com)

print(sample_url[7:-4])

